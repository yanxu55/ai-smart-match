# OpenAI Configuration
# Choose ONE of the following configurations:

# Option 1: Regular OpenAI (openai.com)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# Option 2: Azure OpenAI (recommended for enterprise)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_CHAT_MODEL=gpt-4
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Embedding Model Configuration (for vector similarity search)
# Options:
# - all-MiniLM-L6-v2 (384 dim, fast, good performance) - Default
# - all-mpnet-base-v2 (768 dim, slower, better performance)
# - multi-qa-MiniLM-L6-cos-v1 (384 dim, optimized for Q&A)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Available Azure OpenAI Models (depending on your deployment):
# - gpt-4
# - gpt-4-32k
# - gpt-35-turbo
# - gpt-35-turbo-16k

# Available Regular OpenAI Models:
# - gpt-4
# - gpt-4-turbo-preview
# - gpt-3.5-turbo
# - gpt-3.5-turbo-16k
